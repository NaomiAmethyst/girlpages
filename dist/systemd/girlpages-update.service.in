[Unit]
Description=Refresh girlpages (man pages, but make them girly)
Documentation=man:girl(1)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=@BINDIR@/girl --bulk --update --prune --quiet
# The claude CLI is often installed per-user under ~/.local/bin.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
TimeoutStartSec=infinity
